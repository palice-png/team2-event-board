generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum EventStatus {
  draft
  published
  cancelled
  past
}

enum EventCategory {
  social
  educational
  volunteer
  sports
  arts
}

enum RsvpStatus {
  confirmed    // team decision — spec says "going" but team standardized on "confirmed" (commit 78155ac)
  waitlisted
  cancelled
}
