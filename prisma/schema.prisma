generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum EventStatus {
  draft
  published
  cancelled
  past
}

enum EventCategory {
  social
  educational
  volunteer
  sports
  arts
}

enum RsvpStatus {
  confirmed
  waitlisted    
  cancelled
}

model Event {
  id            String        @id @default(cuid())
  title         String
  description   String
  location      String
  category      EventCategory
  capacity      Int?                       // null = no limit
  status        EventStatus   @default(draft)
  startDatetime DateTime
  endDatetime   DateTime
  organizerId   String                     // auth-managed user — no FK
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  rsvps         Rsvp[]
}

model Rsvp {
  id        String     @id @default(cuid())
  eventId   String
  userId    String                        // auth-managed user — no FK
  status    RsvpStatus
  createdAt DateTime   @default(now())   // deterministic waitlist ordering

  event     Event      @relation(fields: [eventId], references: [id])

  @@unique([eventId, userId])            // one RSVP per member per event
}