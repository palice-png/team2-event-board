<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-1">My RSVPs</h1>
  <p class="text-slate-500 mb-0">All events you have RSVPed to.</p>
</section>

<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<!-- Upcoming -->
<section class="mb-5" x-data="{ open: true }">
  <button
    type="button"
    @click="open = !open"
    class="flex items-center gap-2 mb-3 group w-full text-left"
  >
    <h2 class="text-xl font-semibold text-slate-800">Upcoming</h2>
    <svg
      class="w-4 h-4 text-slate-400 transition-transform duration-200"
      :class="open ? 'rotate-0' : '-rotate-90'"
      fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div x-show="open" x-collapse>
    <% if (rsvps.upcoming.length === 0) { %>
      <div class="p-6 border border-slate-200 rounded-2xl bg-white shadow-sm text-slate-500">
        You have no upcoming RSVPs.
      </div>
    <% } else { %>
      <ul class="space-y-3 list-none p-0 m-0">
        <% for (const entry of rsvps.upcoming) { %>
          <li class="p-5 border border-slate-200 rounded-2xl bg-white shadow-sm flex items-start justify-between gap-4 flex-wrap">
            <div>
              <p class="font-semibold text-slate-900 mb-1"><%= entry.event.title %></p>
              <p class="text-sm text-slate-500 mb-0.5">
                <%= new Date(entry.event.date).toLocaleDateString("en-US", { weekday: "short", year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }) %>
              </p>
              <p class="text-sm text-slate-500 mb-0"><%= entry.event.location %></p>
            </div>
            <div class="flex items-center gap-3 flex-shrink-0">
              <% if (entry.status === "confirmed") { %>
                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700">Confirmed</span>
              <% } else { %>
                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-700">Waitlisted</span>
              <% } %>
              <button
                type="button"
                disabled
                title="Cancel RSVP — coming soon"
                class="px-3.5 py-2 rounded-lg bg-slate-100 text-slate-400 border border-slate-200 text-sm font-medium cursor-not-allowed"
              >
                Cancel
              </button>
            </div>
          </li>
        <% } %>
      </ul>
    <% } %>
  </div>
</section>

<!-- Past & Cancelled -->
<section x-data="{ open: true }">
  <button
    type="button"
    @click="open = !open"
    class="flex items-center gap-2 mb-3 group w-full text-left"
  >
    <h2 class="text-xl font-semibold text-slate-800">Past &amp; Cancelled</h2>
    <svg
      class="w-4 h-4 text-slate-400 transition-transform duration-200"
      :class="open ? 'rotate-0' : '-rotate-90'"
      fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div x-show="open" x-collapse>
    <% if (rsvps.pastOrCancelled.length === 0) { %>
      <div class="p-6 border border-slate-200 rounded-2xl bg-white shadow-sm text-slate-500">
        No past or cancelled RSVPs.
      </div>
    <% } else { %>
      <ul class="space-y-3 list-none p-0 m-0">
        <% for (const entry of rsvps.pastOrCancelled) { %>
          <li class="p-5 border border-slate-200 rounded-2xl bg-white shadow-sm flex items-start justify-between gap-4 flex-wrap opacity-75">
            <div>
              <p class="font-semibold text-slate-700 mb-1"><%= entry.event.title %></p>
              <p class="text-sm text-slate-500 mb-0.5">
                <%= new Date(entry.event.date).toLocaleDateString("en-US", { weekday: "short", year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }) %>
              </p>
              <p class="text-sm text-slate-500 mb-0"><%= entry.event.location %></p>
            </div>
            <div class="flex-shrink-0">
              <% if (entry.status === "cancelled") { %>
                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-600">Cancelled</span>
              <% } else if (entry.event.status === "cancelled") { %>
                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-500">Event Cancelled</span>
              <% } else { %>
                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-500">Past</span>
              <% } %>
            </div>
          </li>
        <% } %>
      </ul>
    <% } %>
  </div>
</section>
