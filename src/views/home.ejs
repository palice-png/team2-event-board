<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-3">Team 3 Event Board</h1>
  <p class="text-slate-500">
    Welcome to our event board! This was created by Josie, Jongchan, Harini, Alice, and Jigeon 
  </p>
  <% if (session.authenticatedUser) { %>
    <p class="text-slate-500 mt-2 mb-0">
      Signed in as <strong class="text-slate-700"><%= session.authenticatedUser.displayName %></strong>
      (<%= session.authenticatedUser.email %>, role:
      <strong class="text-slate-700"><%= session.authenticatedUser.role %></strong>).
    </p>
  <% } %>
</section>

<% if (pageError) { %>
  <%- include("partials/error", { message: pageError }) %>
<% } %>

<% if (session.authenticatedUser?.role === "admin" || session.authenticatedUser?.role === "staff") { %>
  <section class="max-w-3xl p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
    <h2 class="text-xl font-semibold text-slate-800 mb-3">Organizer Actions</h2>
    <div class="flex gap-3 flex-wrap">
      <a
        href="/events/new"
        class="inline-block px-5 py-2.5 rounded-lg bg-blue-600 text-white font-semibold text-sm shadow-sm hover:bg-blue-700 no-underline"
      >
        + Create Event
      </a>
      <a
        href="/organizer/dashboard"
        class="inline-block px-5 py-2.5 rounded-lg bg-white border border-slate-200 text-slate-800 font-semibold text-sm shadow-sm hover:bg-slate-50 no-underline"
      >
        Organizer Dashboard
      </a>
    </div>
  </section>
<% } %>

<% if (session.authenticatedUser?.role === "user") { %>
  <section class="mb-5">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-xl font-semibold text-slate-800">Upcoming Events</h2>
      <a href="/events" class="text-sm text-blue-700 font-medium no-underline hover:underline">View all</a>
    </div>

    <% if (events.length === 0) { %>
      <div class="p-6 border border-slate-200 rounded-2xl bg-white shadow-sm text-slate-500">
        No published events yet. Check back soon!
      </div>
    <% } else { %>
      <div class="flex flex-col gap-4">
        <% for (const event of events) { %>
          <div class="p-5 border border-slate-200 rounded-2xl bg-white shadow-sm flex items-start justify-between gap-4 flex-wrap">
            <div>
              <h3 class="font-semibold text-slate-900 mb-1">
                <a href="/events/<%= event.id %>" class="text-blue-700 no-underline hover:underline"><%= event.title %></a>
              </h3>
              <p class="text-sm text-slate-500 mb-0.5"><%= event.location %> &middot; <%= event.category %></p>
              <p class="text-sm text-slate-500 mb-0">
                <%= new Date(event.startDatetime).toLocaleDateString("en-US", { weekday: "short", year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }) %>
              </p>
            </div>
            <a
              href="/events/<%= event.id %>"
              class="shrink-0 px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium no-underline hover:bg-blue-700"
            >
              View
            </a>
          </div>
        <% } %>
      </div>
    <% } %>
  </section>
<% } %>
