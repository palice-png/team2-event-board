<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-1">Event Archive</h1>
  <p class="text-slate-500 mb-0">Past and cancelled events.</p>
</section>

<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<!-- Category filter -->
<form method="get" action="/events/archive" class="mb-5 flex items-center gap-3 flex-wrap">
  <label for="category" class="text-sm font-medium text-slate-700">Filter by category:</label>
  <select
    id="category"
    name="category"
    class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm"
    onchange="this.form.submit()"
  >
    <option value="" <%= !category ? 'selected' : '' %>>All categories</option>
    <option value="social"       <%= category === 'social'       ? 'selected' : '' %>>Social</option>
    <option value="educational"  <%= category === 'educational'  ? 'selected' : '' %>>Educational</option>
    <option value="volunteer"    <%= category === 'volunteer'    ? 'selected' : '' %>>Volunteer</option>
    <option value="sports"       <%= category === 'sports'       ? 'selected' : '' %>>Sports</option>
    <option value="arts"         <%= category === 'arts'         ? 'selected' : '' %>>Arts</option>
  </select>
</form>

<% if (events.length === 0) { %>
  <div class="p-6 border border-slate-200 rounded-2xl bg-white shadow-sm text-slate-500">
    No archived events<% if (category) { %> in the <strong><%= category %></strong> category<% } %>.
  </div>
<% } else { %>
  <div class="flex flex-col gap-4">
    <% for (const event of events) { %>
      <div class="p-5 border border-slate-200 rounded-2xl bg-slate-100 shadow-sm flex items-start justify-between gap-4 flex-wrap opacity-75">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <h2 class="text-lg font-semibold text-slate-700">
              <a href="/events/<%= event.id %>" class="no-underline hover:underline text-slate-700"><%= event.title %></a>
            </h2>
            <% if (event.status === "cancelled") { %>
              <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-600">Cancelled</span>
            <% } else { %>
              <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-slate-200 text-slate-500">Past</span>
            <% } %>
          </div>
          <p class="text-sm text-slate-500 mb-0.5"><%= event.location %> &middot; <%= event.category %></p>
          <p class="text-sm text-slate-500 mb-0">
            <%= new Date(event.startDatetime).toLocaleDateString("en-US", { weekday: "short", year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }) %>
          </p>
        </div>
      </div>
    <% } %>
  </div>
<% } %>
