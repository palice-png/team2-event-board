<% const values = event ?? {}; %>

<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-3">Edit Event</h1>
  <p class="text-slate-500 mb-0">
    Update the details for this event.
  </p>
</section>

<div id="edit-event-result">
  <%- include("partials/editEventResult", {
    errorMessage,
    successMessage: null,
  }) %>
</div>


<section id="edit-form-section" class="max-w-4xl p-6 border border-slate-200 rounded-2xl bg-white shadow-lg"
  x-data="{ isDirty: false, showWarning: false }"
  x-on:beforeunload.window="if (isDirty) $event.preventDefault()"
>
  <form
  action="/events/<%= values.id %>/edit"
  method="post"
  class="space-y-6"
  hx-post="/events/<%= values.id %>/edit"
  hx-target="#edit-event-result"
  hx-swap="innerHTML"
  x-on:input="isDirty = true"
  x-on:change="isDirty = true"
  x-on:htmx:after-request="isDirty = false"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="md:col-span-2">
        <label for="title" class="block text-sm font-medium text-slate-700 mb-2">
          Title
        </label>
        <input
          id="title"
          name="title"
          type="text"
          value="<%= values.title ?? '' %>"
          required
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        />
      </div>

      <div class="md:col-span-2">
        <label for="description" class="block text-sm font-medium text-slate-700 mb-2">
          Description
        </label>
        <textarea
          id="description"
          name="description"
          rows="5"
          required
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 shadow-sm resize-y focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        ><%= values.description ?? '' %></textarea>
      </div>

      <div>
        <label for="location" class="block text-sm font-medium text-slate-700 mb-2">
          Location
        </label>
        <input
          id="location"
          name="location"
          type="text"
          value="<%= values.location ?? '' %>"
          required
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        />
      </div>
      
      <div>
        <label for="category" class="block text-sm font-medium text-slate-700 mb-2">
          Category
        </label>
        <select
          id="category"
          name="category"
          required
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">Select a category</option>
          <option value="social" <%= values.category === 'social' ? 'selected' : '' %>>Social</option>
          <option value="educational" <%= values.category === 'educational' ? 'selected' : '' %>>Educational</option>
          <option value="volunteer" <%= values.category === 'volunteer' ? 'selected' : '' %>>Volunteer</option>
          <option value="sports" <%= values.category === 'sports' ? 'selected' : '' %>>Sports</option>
          <option value="arts" <%= values.category === 'arts' ? 'selected' : '' %>>Arts</option>
        </select>
      </div>

      <div>
        <label for="capacity" class="block text-sm font-medium text-slate-700 mb-2">
          Capacity
        </label>
        <input
          id="capacity"
          name="capacity"
          type="number"
          min="1"
          step="1"
          value="<%= values.capacity ?? '' %>"
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        />
        <p class="mt-2 text-sm text-slate-500">
          Leave blank if the event has no attendance limit.
        </p>
      </div>

      <div></div>

      <div>
        <label for="startDatetime" class="block text-sm font-medium text-slate-700 mb-2">
          Start date and time
        </label>
        <input
          id="startDatetime"
          name="startDatetime"
          type="datetime-local"
          value="<%= values.startDatetime ? new Date(values.startDatetime).toISOString().slice(0,16) : '' %>"
          required
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        />
      </div>

      <div>
        <label for="endDatetime" class="block text-sm font-medium text-slate-700 mb-2">
          End date and time
        </label>
        <input
          id="endDatetime"
          name="endDatetime"
          type="datetime-local"
          value="<%= values.endDatetime ? new Date(values.endDatetime).toISOString().slice(0,16) : '' %>"
          required
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        />
      </div>
    </div>

    <div class="pt-2 flex gap-3">
      <button
        type="submit"
        class="px-5 py-3 rounded-xl bg-blue-600 text-white font-medium cursor-pointer hover:bg-blue-700 shadow-sm"
      >
        Save Changes
      </button>
      <a
      href="/events/<%= values.id %>"
      class="px-5 py-3 rounded-xl bg-slate-100 text-slate-700 font-medium hover:bg-slate-200"
      x-on:click="if (isDirty) { showWarning = true; $event.preventDefault(); }"
    >
      Cancel
    </a>
    
    <div
      x-show="showWarning"
      class="fixed inset-0 bg-black/40 flex items-center justify-center z-50"
      x-cloak
    >
      <div class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-xl border border-slate-200">
        <h3 class="text-base font-semibold text-slate-900 mb-2">Unsaved changes</h3>
        <p class="text-sm text-slate-500 mb-4">You have unsaved changes. Are you sure you want to leave?</p>
        <div class="flex gap-3 justify-end">
          <button
            type="button"
            class="px-4 py-2 rounded-xl bg-slate-100 text-slate-700 text-sm font-medium hover:bg-slate-200"
            x-on:click="showWarning = false"
          >
            Stay
          </button>
          <a
            href="/events/<%= values.id %>"
            class="px-4 py-2 rounded-xl bg-red-600 text-white text-sm font-medium hover:bg-red-700"
            x-on:click="isDirty = false"
          >
            Leave anyway
          </a>
        </div>
      </div>
    </div>