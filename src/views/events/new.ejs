<% const values = formData ?? {}; %>

<section class="mb-5 rounded-2xl border border-slate-200 bg-gradient-to-b from-white to-slate-50 p-4 shadow-lg sm:p-6 md:p-8">
  <p class="mb-2 text-xs font-medium uppercase tracking-wide text-blue-600 sm:text-sm">
    Organizer Tool
  </p>
  <h1 class="mb-3 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl md:text-4xl">
    Create Event
  </h1>
  <p class="mb-0 max-w-2xl text-sm leading-relaxed text-slate-500 sm:text-base">
    Newly created events start as drafts. You can publish them after reviewing the details.
  </p>
</section>

<div id="create-event-result">
  <%- include("partials/createEventResult", {
    errorMessage,
    successMessage: null,
  }) %>
</div>

<section
  class="w-full rounded-2xl border border-slate-200 bg-white p-4 shadow-lg sm:p-6 md:rounded-3xl md:p-8"
>
  <form
    action="/events"
    method="post"
    class="space-y-6"
    hx-post="/events"
    hx-target="#create-event-result"
    hx-swap="innerHTML"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="md:col-span-2">
        <label for="title" class="block text-sm font-medium text-slate-700 mb-2">
          Title
        </label>
        <input
          id="title"
          name="title"
          type="text"
          value="<%= values.title ?? '' %>"
          required
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        />
      </div>

      <div
        class="md:col-span-2"
        x-data="{ count: <%= String(values.description ?? '').length %>, max: 500 }"
      >
        <div class="mb-2 flex items-center justify-between gap-3">
          <label for="description" class="block text-sm font-medium text-slate-700">
            Description
          </label>

          <p
            class="text-xs font-medium"
            x-bind:class="count >= max ? 'text-red-600' : count > max * 0.9 ? 'text-amber-600' : 'text-slate-500'"
            aria-live="polite"
          >
            <span x-text="count"></span> / <span x-text="max"></span> characters
          </p>
        </div>

        <textarea
          id="description"
          name="description"
          rows="5"
          maxlength="500"
          required
          x-on:input="count = $event.target.value.length"
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 shadow-sm resize-y focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          ><%= values.description ?? '' %></textarea>

        <p class="mt-2 text-sm text-slate-500">
          Keep the description clear and useful for members deciding whether to attend.
        </p>
      </div>

      <div>
        <label for="location" class="block text-sm font-medium text-slate-700 mb-2">
          Location
        </label>
        <input
          id="location"
          name="location"
          type="text"
          value="<%= values.location ?? '' %>"
          required
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        />
      </div>

      <div>
        <label for="category" class="block text-sm font-medium text-slate-700 mb-2">
          Category
        </label>
        <select
          id="category"
          name="category"
          required
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">Select a category</option>
          <option value="social" <%= values.category === 'social' ? 'selected' : '' %>>Social</option>
          <option value="educational" <%= values.category === 'educational' ? 'selected' : '' %>>Educational</option>
          <option value="volunteer" <%= values.category === 'volunteer' ? 'selected' : '' %>>Volunteer</option>
          <option value="sports" <%= values.category === 'sports' ? 'selected' : '' %>>Sports</option>
          <option value="arts" <%= values.category === 'arts' ? 'selected' : '' %>>Arts</option>
        </select>
      </div>

      <div>
        <label for="capacity" class="block text-sm font-medium text-slate-700 mb-2">
          Capacity
        </label>
        <input
          id="capacity"
          name="capacity"
          type="number"
          min="1"
          step="1"
          value="<%= values.capacity ?? '' %>"
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        />
        <p class="mt-2 text-sm text-slate-500">
          Leave blank if the event has no attendance limit.
        </p>
      </div>

      <div></div>

      <div>
        <label for="startDatetime" class="block text-sm font-medium text-slate-700 mb-2">
          Start date and time
        </label>
        <input
          id="startDatetime"
          name="startDatetime"
          type="datetime-local"
          value="<%= values.startDatetime ?? '' %>"
          required
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        />
      </div>

      <div>
        <label for="endDatetime" class="block text-sm font-medium text-slate-700 mb-2">
          End date and time
        </label>
        <input
          id="endDatetime"
          name="endDatetime"
          type="datetime-local"
          value="<%= values.endDatetime ?? '' %>"
          required
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        />
      </div>
    </div>

    <div class="flex flex-col pt-2 sm:flex-row sm:justify-end">
      <button
        type="submit"
        class="w-full rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 sm:w-auto sm:min-w-[10rem]"
      >
        Create Event
      </button>
    </div>
  </form>
</section>