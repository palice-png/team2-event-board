<section
  id="comments-section"
  class="mx-auto mb-5 mt-5 w-full max-w-4xl rounded-2xl border border-slate-200 bg-white p-4 shadow-md sm:mb-6 sm:p-6 md:rounded-3xl md:p-7 lg:p-8"
>
  <h2 class="text-xl font-semibold text-slate-900 mb-4">Comments</h2>
  
    <div id="comment-list" class="space-y-4 mb-6">
      <% if (comments && comments.length > 0) { %>
        <% for (const comment of comments) { %>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-medium text-slate-700 mb-1"><%= comment.displayName %></p>
                <p class="text-slate-800"><%= comment.body %></p>
                <p class="text-xs text-slate-400 mt-2"><%= comment.createdAt %></p>
              </div>
              <% if (session.authenticatedUser?.userId === comment.userId || session.authenticatedUser?.role === "admin") { %>
                <form
                  method="post"
                  action="/comments/<%= comment.id %>/delete"
                  class="m-0"
                  hx-post="/comments/<%= comment.id %>/delete"
                  hx-target="#comments-section"
                  hx-swap="outerHTML"
                  hx-vals='{"eventId": "<%= eventId %>"}'
                >
                  <input type="hidden" name="eventOrganizerId" value="<%= eventOrganizerId %>" />
                  <button
                    type="submit"
                    class="px-3 py-1 rounded-lg bg-white text-red-600 border border-red-200 cursor-pointer text-xs font-medium hover:bg-red-50"
                  >
                    Delete
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        <% } %>
      <% } else { %>
        <p class="text-slate-400 text-sm">No comments yet. Be the first to comment!</p>
      <% } %>
    </div>
  
    <form
      method="post"
      action="/events/<%= eventId %>/comments"
      class="space-y-3"
      hx-post="/events/<%= eventId %>/comments"
      hx-target="#comments-section"
      hx-swap="outerHTML"
    >
      <div>
        <label for="content" class="block text-sm font-medium text-slate-700 mb-2">
          Add a comment
        </label>
        <textarea
          id="content"
          name="content"
          rows="3"
          placeholder="Write your comment here..."
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 shadow-sm resize-y focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        ></textarea>
      </div>
      <button
        type="submit"
        class="px-5 py-2 rounded-xl bg-blue-600 text-white font-medium cursor-pointer hover:bg-blue-700 shadow-sm"
      >
        Post Comment
      </button>
    </form>
  </section>