<% if (errorMessage) { %>
  <section
    class="mb-4 rounded-xl border border-red-200 bg-red-50 p-4 text-red-800"
    aria-live="polite"
  >
    <h3 class="mb-1 text-base font-semibold">Error</h3>
    <p class="mb-0 text-sm"><%= errorMessage %></p>
  </section>
<% } %>

<% if (successMessage) { %>
  <section
    class="mb-4 rounded-xl border border-green-200 bg-green-50 p-4 text-green-800"
    aria-live="polite"
  >
    <h3 class="mb-1 text-base font-semibold">Success</h3>
    <p class="mb-0 text-sm"><%= successMessage %></p>
  </section>
<% } %>