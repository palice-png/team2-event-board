<section
  class="mb-6 sm:mb-8 rounded-2xl border border-slate-200/80 bg-gradient-to-br from-white via-slate-50/80 to-blue-50/30 p-5 shadow-lg sm:p-6 md:p-8 lg:rounded-3xl"
>
  <h1
    class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl md:text-4xl lg:mb-4"
  >
    Organizer dashboard
  </h1>
  <p class="max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base md:text-lg">
    Your events grouped by status. Attendee counts include only RSVPs marked as going.
  </p>
</section>

<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<section class="mx-auto mb-5 max-w-3xl rounded-2xl border border-slate-200 bg-white p-4 shadow-md sm:mb-6 sm:p-5 md:max-w-4xl md:rounded-3xl md:p-6 lg:mb-8 lg:max-w-5xl">
  <div class="mb-3 flex items-center justify-between gap-3 border-b border-slate-100 pb-3 sm:mb-4 sm:pb-4">
    <h2 class="text-base font-semibold text-slate-900 sm:text-lg md:text-xl">Organizer Insights</h2>
    <span class="text-xs text-slate-500 sm:text-sm">Demo Day Optional</span>
  </div>
  <dl class="grid grid-cols-2 gap-2 text-sm sm:grid-cols-3 sm:gap-3 md:grid-cols-4 lg:grid-cols-7">
    <div class="rounded-lg border border-slate-200 bg-slate-50/80 px-3 py-2">
      <dt class="text-xs uppercase tracking-wide text-slate-500">Total Events</dt>
      <dd class="mt-1 text-base font-semibold text-slate-900"><%= dashboard.insights.totalEvents %></dd>
    </div>
    <div class="rounded-lg border border-slate-200 bg-slate-50/80 px-3 py-2">
      <dt class="text-xs uppercase tracking-wide text-slate-500">Published</dt>
      <dd class="mt-1 text-base font-semibold text-slate-900"><%= dashboard.insights.published %></dd>
    </div>
    <div class="rounded-lg border border-slate-200 bg-slate-50/80 px-3 py-2">
      <dt class="text-xs uppercase tracking-wide text-slate-500">Drafts</dt>
      <dd class="mt-1 text-base font-semibold text-slate-900"><%= dashboard.insights.drafts %></dd>
    </div>
    <div class="rounded-lg border border-slate-200 bg-slate-50/80 px-3 py-2">
      <dt class="text-xs uppercase tracking-wide text-slate-500">Cancelled/Past</dt>
      <dd class="mt-1 text-base font-semibold text-slate-900"><%= dashboard.insights.cancelledOrPast %></dd>
    </div>
    <div class="rounded-lg border border-slate-200 bg-slate-50/80 px-3 py-2">
      <dt class="text-xs uppercase tracking-wide text-slate-500">Total Attendees</dt>
      <dd class="mt-1 text-base font-semibold text-slate-900"><%= dashboard.insights.totalAttendees %></dd>
    </div>
    <div class="rounded-lg border border-amber-200 bg-amber-50/80 px-3 py-2">
      <dt class="text-xs uppercase tracking-wide text-amber-700">Needs Attention</dt>
      <dd class="mt-1 text-base font-semibold text-amber-900"><%= dashboard.insights.needsAttention %></dd>
    </div>
    <div class="rounded-lg border border-blue-200 bg-blue-50/80 px-3 py-2">
      <dt class="text-xs uppercase tracking-wide text-blue-700">Almost Full</dt>
      <dd class="mt-1 text-base font-semibold text-blue-900"><%= dashboard.insights.almostFull %></dd>
    </div>
  </dl>
</section>

<% const sections = [
  { key: "published", label: "Published" },
  { key: "draft", label: "Draft" },
  { key: "cancelledOrPast", label: "Cancelled or past" },
]; %>

<div class="mx-auto flex max-w-3xl flex-col gap-5 sm:gap-6 md:max-w-4xl lg:max-w-5xl lg:gap-8">
  <% sections.forEach(function (section) { %>
    <section
      class="rounded-2xl border border-slate-200 bg-white p-4 shadow-md sm:p-6 md:rounded-3xl md:p-7 lg:p-8"
    >
      <div class="mb-4 flex flex-col gap-1 border-b border-slate-100 pb-4 sm:mb-5 sm:flex-row sm:items-end sm:justify-between sm:pb-5">
        <h2 class="text-lg font-semibold text-slate-900 sm:text-xl md:text-2xl">
          <%= section.label %>
        </h2>
      </div>
      <% const items = dashboard[section.key]; %>
      <% if (!items || items.length === 0) { %>
        <p class="rounded-xl border border-dashed border-slate-200 bg-slate-50/80 px-4 py-6 text-center text-sm text-slate-500 sm:py-8 sm:text-base">
          No events in this section.
        </p>
      <% } else { %>
        <ul class="m-0 list-none space-y-3 p-0 sm:space-y-4 md:space-y-5">
          <% items.forEach(function (row) { %>
            <%- include("partials/dashboard-row", { row }) %>
          <% }); %>
        </ul>
      <% } %>
    </section>
  <% }); %>
</div>
