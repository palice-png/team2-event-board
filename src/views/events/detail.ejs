<div>
  <h1>Event Details</h1>

  <% if (pageError) { %>
    <div>
      <strong>Unable to load event</strong>
      <p><%= pageError %></p>
    </div>
  <% } %>

  <section>
    <h2><%= event.title %></h2>
    <p><%= event.description %></p>
  </section>

  <section>
    <h3>Event Info</h3>
    <p><strong>Location:</strong> <%= event.location %></p>
    <p><strong>Category:</strong> <%= event.category %></p>
    <p><strong>Status:</strong> <%= event.status %></p>
    <p><strong>Organizer ID:</strong> <%= event.organizerId %></p>
  </section>

  <section>
    <h3>Date and Time</h3>
    <p><strong>Starts:</strong> <%= event.startDatetime %></p>
    <p><strong>Ends:</strong> <%= event.endDatetime %></p>
  </section>

  <section>
    <h3>Attendance</h3>
    <% if (event.capacity === null) { %>
      <p><strong>Attendees:</strong> <%= attendeeCount %> / No limit</p>
    <% } else { %>
      <p><strong>Attendees:</strong> <%= attendeeCount %> / <%= event.capacity %></p>
    <% } %>
  </section>
</div>