<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <div>
    <p class="text-sm font-medium uppercase tracking-wide text-blue-600 mb-2">
      Event Detail
    </p>
    <h1 class="text-3xl font-bold text-slate-900 mb-3"><%= event.title %></h1>
    <p class="text-slate-600 max-w-3xl"><%= event.description %></p>
  </div>
</section>

<section class="max-w-4xl p-6 border border-slate-200 rounded-2xl bg-white shadow-lg mb-5">
  <h2 class="text-xl font-semibold text-slate-900 mb-4">Event Information</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-slate-700">
    <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
      <p class="text-sm text-slate-500 mb-1">Location</p>
      <p class="font-medium text-slate-800"><%= event.location %></p>
    </div>

    <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
      <p class="text-sm text-slate-500 mb-1">Category</p>
      <p class="font-medium text-slate-800"><%= event.category %></p>
    </div>

    <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
      <p class="text-sm text-slate-500 mb-1">Organizer ID</p>
      <p class="font-medium text-slate-800"><%= event.organizerId %></p>
    </div>

    <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
      <p class="text-sm text-slate-500 mb-1">Attendance</p>
      <% if (event.capacity === null) { %>
        <p class="font-medium text-slate-800"><%= attendeeCount %> / No limit</p>
      <% } else { %>
        <p class="font-medium text-slate-800"><%= attendeeCount %> / <%= event.capacity %></p>
      <% } %>
    </div>
  </div>
</section>

<section class="max-w-4xl p-6 border border-slate-200 rounded-2xl bg-white shadow-lg mb-5">
  <h2 class="text-xl font-semibold text-slate-900 mb-4">Schedule</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-slate-700">
    <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
      <p class="text-sm text-slate-500 mb-1">Starts</p>
      <p class="font-medium text-slate-800"><%= event.startDatetime %></p>
    </div>

    <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
      <p class="text-sm text-slate-500 mb-1">Ends</p>
      <p class="font-medium text-slate-800"><%= event.endDatetime %></p>
    </div>
  </div>
</section>

<%- include("partials/detail-status-actions", { event, actingUser: session.authenticatedUser }) %>

<%- include("partials/comments", { comments, eventId: event.id, session }) %>