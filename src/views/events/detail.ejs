<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<section
  class="mb-5 rounded-2xl border border-slate-200/80 bg-gradient-to-br from-white via-slate-50/80 to-blue-50/30 p-5 shadow-lg sm:mb-6 sm:p-6 md:p-8 lg:mb-8 lg:rounded-3xl"
>
  <div>
    <p
      class="mb-2 text-xs font-medium uppercase tracking-wide text-blue-600 sm:text-sm"
    >
      Event Detail
    </p>
    <h1
      class="mb-3 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl md:text-4xl"
    >
      <%= event.title %>
    </h1>
    <p class="max-w-3xl text-sm leading-relaxed text-slate-600 sm:text-base md:text-lg">
      <%= event.description %>
    </p>
  </div>
</section>

<section
  class="mx-auto mb-5 max-w-4xl rounded-2xl border border-slate-200 bg-white p-4 shadow-md sm:mb-6 sm:p-6 md:rounded-3xl md:p-7 lg:p-8"
>
  <h2 class="mb-4 text-lg font-semibold text-slate-900 sm:mb-5 sm:text-xl md:text-2xl">
    Event Information
  </h2>

  <div
    class="grid grid-cols-1 gap-3 text-slate-700 sm:grid-cols-2 sm:gap-4 md:gap-5 lg:grid-cols-2"
  >
    <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-3 sm:p-4 md:p-5">
      <p class="mb-1 text-xs font-medium uppercase tracking-wide text-slate-500 sm:text-sm">
        Location
      </p>
      <p class="font-medium text-slate-800 sm:text-base"><%= event.location %></p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-3 sm:p-4 md:p-5">
      <p class="mb-1 text-xs font-medium uppercase tracking-wide text-slate-500 sm:text-sm">
        Category
      </p>
      <p class="font-medium text-slate-800 sm:text-base"><%= event.category %></p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-3 sm:p-4 md:p-5">
      <p class="mb-1 text-xs font-medium uppercase tracking-wide text-slate-500 sm:text-sm">
        Organizer ID
      </p>
      <p class="break-all font-medium text-slate-800 sm:text-base"><%= event.organizerId %></p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-3 sm:p-4 md:p-5">
      <p class="mb-1 text-xs font-medium uppercase tracking-wide text-slate-500 sm:text-sm">
        Attendance
      </p>
      <% if (event.capacity === null) { %>
        <p class="font-medium text-slate-800 sm:text-base"><%= attendeeCount %> / No limit</p>
      <% } else { %>
        <p class="font-medium text-slate-800 sm:text-base"><%= attendeeCount %> / <%= event.capacity %></p>
      <% } %>
    </div>
  </div>
</section>

<section
  class="mx-auto mb-5 max-w-4xl rounded-2xl border border-slate-200 bg-white p-4 shadow-md sm:mb-6 sm:p-6 md:rounded-3xl md:p-7 lg:p-8"
  x-data='{
    relativeTime(iso) {
      const target = new Date(iso);
      if (Number.isNaN(target.getTime())) return "";

      const diffMs = target.getTime() - Date.now();
      const absMs = Math.abs(diffMs);
      const minute = 60 * 1000;
      const hour = 60 * minute;
      const day = 24 * hour;
      const formatter = new Intl.RelativeTimeFormat("en", { numeric: "auto" });

      if (absMs < minute) return "now";
      if (absMs < hour) return formatter.format(Math.round(diffMs / minute), "minute");
      if (absMs < day) return formatter.format(Math.round(diffMs / hour), "hour");

      return formatter.format(Math.round(diffMs / day), "day");
    }
  }'
>
  <h2 class="mb-4 text-lg font-semibold text-slate-900 sm:mb-5 sm:text-xl md:text-2xl">
    Schedule
  </h2>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 md:gap-5">
    <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-3 sm:p-4 md:p-5">
      <p class="mb-1 text-xs font-medium uppercase tracking-wide text-slate-500 sm:text-sm">
        Starts
      </p>
      <time
        datetime="<%= event.startDatetime %>"
        class="block text-base font-semibold text-slate-900 sm:text-lg"
      >
        <%= new Date(event.startDatetime).toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short" }) %>
      </time>
      <p class="mt-3 inline-flex rounded-full bg-blue-50 px-3 py-1 text-sm font-semibold text-blue-700 ring-1 ring-inset ring-blue-100">
        <span x-text='relativeTime(<%- JSON.stringify(event.startDatetime) %>)'></span>
      </p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-3 sm:p-4 md:p-5">
      <p class="mb-1 text-xs font-medium uppercase tracking-wide text-slate-500 sm:text-sm">
        Ends
      </p>
      <time
        datetime="<%= event.endDatetime %>"
        class="block text-base font-semibold text-slate-900 sm:text-lg"
      >
        <%= new Date(event.endDatetime).toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short" }) %>
      </time>
      <p class="mt-3 inline-flex rounded-full bg-slate-100 px-3 py-1 text-sm font-semibold text-slate-700 ring-1 ring-inset ring-slate-200">
        <span x-text='relativeTime(<%- JSON.stringify(event.endDatetime) %>)'></span>
      </p>
    </div>
  </div>
</section>

<%- include("partials/detail-status-actions", { event, actingUser: session.authenticatedUser }) %>
<%- include("partials/comments", { comments, eventId: event.id, session, eventOrganizerId: event.organizerId  }) %>
